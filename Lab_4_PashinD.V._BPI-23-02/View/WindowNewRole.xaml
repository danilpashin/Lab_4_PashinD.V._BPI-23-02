<Window x:Class="Lab_4_PashinD.V._BPI_23_02.View.WindowNewRole"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Lab_4_PashinD.V._BPI_23_02.View"
        mc:Ignorable="d"
        Title="Новая должность" Height="200" Width="230" MinHeight="150" MinWidth="230">
    <Grid>
        <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="40"/>
                <RowDefinition/>
            </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="80" />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>
        <Label Content="Код:" Width="34" HorizontalAlignment="Right" VerticalAlignment="Center" Grid.Row="0" Grid.Column="0"/>
        <TextBox x:Name="IdRoleTBox" Text="{Binding CurrRole.Id}" Width="70" Height="20" HorizontalAlignment="Left" IsEnabled="False" Grid.Row="0" Grid.Column="1"/>
        <Label Content="Должность:" Width="75" HorizontalAlignment="Right" VerticalAlignment="Center" Grid.Row="1" Grid.Column="0"/>
        <TextBox x:Name="RoleTBox" Text="{Binding CurrRole.NameRole}" HorizontalAlignment="Left" Width="120" Height="20" Grid.Row="1" Grid.Column="1"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,0,5,0" Grid.Row="2" Grid.Column="1">
            <Button Content="Сохранить" Margin="0,5,5,5" Height="20" Command="{Binding SaveChange}"/>
            <Button Content="Отменить" Margin="0,5,0,5" Height="20" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
