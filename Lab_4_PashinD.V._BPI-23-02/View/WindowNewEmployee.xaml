<Window x:Class="Lab_4_PashinD.V._BPI_23_02.View.WindowNewEmployee"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Lab_4_PashinD.V._BPI_23_02.View"
        mc:Ignorable="d"
        Title="Добавить сотрудника" Height="300" Width="300">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="100"/>
            <ColumnDefinition Width="115*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="40"/>
            <RowDefinition Height="40"/>
            <RowDefinition Height="40"/>
            <RowDefinition Height="50"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Label Grid.Row="0" Grid.Column="0" Content="Код:" Width="33" VerticalAlignment="Center" HorizontalAlignment="Right"/>
        <TextBox Grid.Row="0" Grid.Column="1" x:Name="IdTBox" Text="{Binding Path=Id}" VerticalAlignment="Center" HorizontalAlignment="Left" Width="70" Height="20" IsEnabled="False"/>
        <Label Grid.Row="1" Grid.Column="0" Content="Должность:" Width="74" VerticalAlignment="Center" HorizontalAlignment="Right"/>
        <ComboBox Grid.Row="1" Grid.Column="1" x:Name="CbRole" VerticalAlignment="Center" HorizontalAlignment="Left" Width="120" Height="25" />
        <Label Grid.Row="2" Grid.Column="0" Content="Фамилия:" Width="62" VerticalAlignment="Center" HorizontalAlignment="Right"/>
        <TextBox Grid.Row="2" Grid.Column="1" x:Name="LastNameTBox" Text="{Binding Path=LastName}" PreviewTextInput="CheckNameInput" VerticalAlignment="Center" HorizontalAlignment="Left" Width="120" Height="20"/>
        <Label Grid.Row="3" Grid.Column="0" Content="Имя:" Width="36" VerticalAlignment="Center" HorizontalAlignment="Right"/>
        <TextBox Grid.Row="3" Grid.Column="1" x:Name="FirstNameTBox" Text="{Binding Path=FirstName}" PreviewTextInput="CheckNameInput" VerticalAlignment="Center" HorizontalAlignment="Left" Width="120" Height="20"/>
        <Label Grid.Row="4" Grid.Column="0" Content="Дата рождения:" Width="97" VerticalAlignment="Center" HorizontalAlignment="Right"/>
        <DatePicker  Grid.Row="4" Grid.Column="1" x:Name="BirthdayTBox" SelectedDate="{Binding Path=Birthday, Mode=TwoWay}" VerticalAlignment="Center" HorizontalAlignment="Left" Width="170" Height="25"/>

        <StackPanel Grid.Row="5" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,5,5,5"  >
            <Button Content="Сохранить" Margin="0,5,5,5" Height="20" Click="SaveChange"/>
            <Button Content="Отменить" Margin="0,5,0,5" Height="20" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
