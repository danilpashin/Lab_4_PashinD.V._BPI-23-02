<Window x:Class="Lab_4_PashinD.V._BPI_23_02.View.WindowNewRole"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Lab_4_PashinD.V._BPI_23_02.View"
        mc:Ignorable="d"
        Title="Новая должность" Height="200" Width="230" MinHeight="150" MinWidth="230">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="40"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,5,0,5">
            <Label Content="Код:" Width="30"/>
            <TextBox x:Name="IdRoleTBox" Text="{Binding Path=Id}" Grid.Row="0" Width="70" Height="20"/>
        </StackPanel>
        <StackPanel Grid.Row="1"  Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,5,0,5">
            <Label Content="Должность:" Grid.Row="0" Width="75"/>
            <TextBox x:Name="RoleTBox" Text="{Binding Path=NameRole}" PreviewTextInput="CheckRoleInput" Grid.Row="0" Width="120" Height="20"/>
        </StackPanel>
        <StackPanel Grid.Row="2"  Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,5,10,5">
            <Button Content="Сохранить" Margin="0,5,5,5" Height="20" Click="SaveChange"/>
            <Button Content="Отменить" Margin="0,5,0,5" Height="20" Click="NoSave"/>
        </StackPanel>
    </Grid>
</Window>
